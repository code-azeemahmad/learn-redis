# PostgreSQL (Durable Source of Truth)
# Replace with your PostgreSQL connection URL:
POSTGRES_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/your_database_name

# Redis (Layer 1 Fast Cache)
REDIS_URL=redis://localhost:6379/0

# Qdrant (Layer 2 Semantic Vector Index)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Ollama LLM & Embedding Server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

# Cache & Vector Parameters
LLM_CACHE_TTL=3600
SIMILARITY_THRESHOLD=0.85
COLLECTION_NAME=llm_semantic_cache
EMBEDDING_DIM=768
